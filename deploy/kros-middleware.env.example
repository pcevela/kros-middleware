# Non-secret configuration for kros-middleware. Copy to
# ~/.config/kros-middleware/kros-middleware.env and adjust.
# Secrets (upstream token, client tokens, webhook secret, approver credentials,
# ntfy token, SMTP password) go into Podman secrets, see README.md.

# Public HTTPS base URL of this service (used in approval links).
KM_PUBLIC_BASE_URL=https://kros.example.com

# Peers trusted to set X-Forwarded-For: the address nginx connects from AS SEEN INSIDE
# the container. With rootless Podman (pasta) this is often not 127.0.0.1. Find it by sending
# one request through nginx and reading the client address in `podman logs kros-middleware`,
# then put exactly that address here. Avoid "*": any local process could then spoof addresses.
KM_FORWARDED_ALLOW_IPS=127.0.0.1

# --- What clients may do --------------------------------------------------------
# Creating invoices through the proxy (POST /api/invoices, /batch, proforma).
KM_ISSUE_ENABLED=false
# Sending invoices to customers: off | approval | auto
KM_SEND_MODE=approval
# KM_SEND_AUTO_ACKNOWLEDGED=true   # required together with KM_SEND_MODE=auto
# Optional: only allow invoices whose IBAN is one of these (comma-separated).
# KM_ALLOWED_IBANS=SK0000000000000000000000
# Approval request lifetime and the maximum number of open requests.
KM_APPROVAL_TTL_HOURS=24
KM_APPROVAL_MAX_PENDING=20

# --- Notifications: ntfy and/or email --------------------------------------------
KM_NOTIFY_CHANNELS=ntfy
# KM_NOTIFY_EVENTS=approval_requested,approval_decided,upload_result_problem,send_status_ok,send_status_problem,signature_invalid
KM_NTFY_URL=https://ntfy.example.com
KM_NTFY_TOPIC=kros
# KM_NTFY_TOKEN_FILE=/run/secrets/ntfy_token
# KM_NTFY_PRIORITY=3
# KM_NTFY_PRIORITY_PROBLEM=4
# KM_NTFY_TAGS=receipt

# KM_SMTP_HOST=smtp.example.com
# KM_SMTP_PORT=587
# KM_SMTP_SECURITY=starttls
# KM_SMTP_USERNAME=kros-middleware@example.com
# KM_SMTP_PASSWORD_FILE=/run/secrets/smtp_password
# KM_EMAIL_FROM=kros-middleware@example.com
# KM_EMAIL_TO=you@example.com
# KM_EMAIL_SUBJECT_PREFIX=[kros-middleware]

# --- Storage ------------------------------------------------------------------------
# Webhook results, approvals and the audit log are kept this many days (minimum 90).
KM_RETENTION_DAYS=90

KM_LOG_LEVEL=info
